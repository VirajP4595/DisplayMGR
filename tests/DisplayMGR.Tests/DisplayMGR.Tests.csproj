<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The parsing code has no Windows dependency, so it is compiled in directly and the tests run anywhere. -->
    <Compile Include="..\..\src\DisplayMGR\Monitors\CapabilitiesParser.cs" Link="CapabilitiesParser.cs" />
    <Compile Include="..\..\src\DisplayMGR\Monitors\VcpCatalog.cs" Link="VcpCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
